@echo off
setlocal enabledelayedexpansion

:: === Variables ===
set "folder=C:\c5a_project\tuya_extension_emon_android_extra_files_html\Final_2_NEW_Design"
set "backupto=C:\c5a_project\tuya_extension_emon_android_extra_files_html"
set "backupfoldername=Final_2_NEW_Design_b1"

:: === Check for existing backup folder ===
set "TARGET=%backupto%\%backupfoldername%"
set NUM=0

:CHECK_FOLDER
set "CURRENT=%TARGET%%NUM%"

if exist "%CURRENT%" (
    set /a NUM+=1
    goto CHECK_FOLDER
) else (
    mkdir "%CURRENT%"
)

:: === Copy everything except "target" ===
robocopy "%folder%" "%CURRENT%" /E /XD target

:: === Copy src explicitly ===
if exist "%folder%\src" (
    robocopy "%folder%\src" "%CURRENT%\src" /E
)

echo Done. Files copied to %CURRENT%.
pause
