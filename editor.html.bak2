<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>EmonCMS - Web Flow Editor</title>
  <style>
    body { background: #000; color: #f4f4f5; font-family: system-ui, sans-serif; margin: 20px; display: flex; flex-direction: column; align-items: center; }
    .hint { color: #71717a; font-size: 12px; margin-bottom: 8px; }

    .preset-btns { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; align-items: center; margin-bottom: 8px; }
    .preset-btn {
      background: #1c1c1f; border: 1px solid #333; color: #aaa;
      padding: 5px 10px; border-radius: 6px; font-size: 11px; cursor: pointer;
    }
    .preset-btn.active { border-color: #10b981; color: #10b981; }

    .mobile-simulator {
      background: #09090b;
      border: 1px solid #333;
      border-radius: 16px;
      padding: 0;
      box-shadow: 0 0 30px rgba(0,0,0,0.8);
      margin-bottom: 12px;
      width: 90vw;
      max-width: 450px;
      overflow: hidden;
    }
    #canvas-container {
      background: #121214;
      border: none;
      border-radius: 0;
      position: relative;
      user-select: none;
      touch-action: none;
      overflow: hidden;
      width: 100%;
    }
    #hud {
      position: absolute; top: 10px; right: 10px;
      background: rgba(16,185,129,0.95); color: #fff;
      padding: 6px 12px; border-radius: 6px;
      font-family: monospace; font-weight: bold; font-size: 13px;
      opacity: 0; transition: opacity 0.2s; pointer-events: none; z-index: 10;
    }
    svg { width: 100%; height: 100%; }
    text { font-family: system-ui, sans-serif; dominant-baseline: central; text-anchor: middle; font-weight: 700; cursor: pointer; }
    rect.box { cursor: move; }
    .handle { cursor: se-resize; }
    textarea {
      background: #1c1c1f; border: 1px solid #27272a; color: #38bdf8;
      font-family: monospace; font-size: 11px; padding: 10px;
      border-radius: 8px; width: 100%; max-width: 450px; height: 180px;
      box-sizing: border-box; resize: vertical; margin-top: 10px;
    }
    button.copy-btn {
      background: #10b981; border: none; color: #fff;
      padding: 12px; border-radius: 8px; font-weight: bold;
      cursor: pointer; width: 100%; max-width: 450px; margin-bottom: 10px;
    }
    #color-picker { position: absolute; visibility: hidden; }
  </style>
</head>
<body>
  <h2>Web Flow Editor</h2>
  <p class="hint">Shift+Click = Color &nbsp;|&nbsp; Scroll = Font Size &nbsp;|&nbsp; Drag = Move &nbsp;|&nbsp; Bottom-right corner = Resize</p>

  <div class="preset-btns">
    <button class="preset-btn" data-h="730">Square 730</button>
    <button class="preset-btn" data-h="950">Tall Phone (950)</button>
    <button class="preset-btn" data-h="1100">Extra Tall (1100)</button>
    <label style="font-size:11px; color:#aaa; display:flex; align-items:center; gap:4px; margin-left:6px;">
      Canvas H:
      <input type="number" id="canvas-h-input" value="1100" style="width:60px; background:#1c1c1f; border:1px solid #333; color:#fff; padding:3px 6px; border-radius:4px; font-size:11px;">
    </label>
    <button class="preset-btn" id="btn-copy-js-line" style="border-color:#38bdf8; color:#38bdf8;">📋 Copy JS line</button>

  </div>

  <div class="mobile-simulator">
    <div id="canvas-container">
      <div id="hud">Size: --</div>
      <svg id="editor-svg" viewBox="0 0 730 1100" preserveAspectRatio="xMidYMid meet"></svg>
    </div>
  </div>

  <button class="copy-btn" id="btn-copy">Copy Updated LAYOUT Code</button>
  <textarea id="output" readonly></textarea>
  <input type="color" id="color-picker">

  <script src="js/02-flow.js"></script>
  
  <script>
    let currentHeight = 1100;

    function setCanvasSize(svgH) {
      currentHeight = svgH;
      localStorage.setItem('editor_preset_height', svgH);
      const container = document.getElementById('canvas-container');
      container.style.height = (container.offsetWidth * (svgH / 730)) + 'px';
      document.getElementById('editor-svg').setAttribute('viewBox', `0 0 730 ${svgH}`);
      const hInput = document.getElementById('canvas-h-input');
      if (hInput && parseInt(hInput.value) !== svgH) hInput.value = svgH;
    }

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        setCanvasSize(parseInt(btn.dataset.h));
        draw();
      });
    });

    document.getElementById('canvas-h-input').addEventListener('change', (e) => {
      const val = Math.max(300, parseInt(e.target.value) || 1100);
      setCanvasSize(val);
      draw();
    });

    const svg = document.getElementById('editor-svg');
    const colorPicker = document.getElementById('color-picker');
    const hud = document.getElementById('hud');
    let activeDrag = null, activeColorNode = null, activeColorLine = null;
    let hudTimeout = null;

    function draw() {
      svg.innerHTML = '';
      for (const [name, d] of Object.entries(LAYOUT)) {
        const cx = d.x + d.w / 2;
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        const r = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        r.setAttribute('x', d.x); r.setAttribute('y', d.y); r.setAttribute('width', d.w); r.setAttribute('height', d.h);
        r.setAttribute('rx', '10'); r.setAttribute('fill', '#141416'); r.setAttribute('stroke', d.color); r.setAttribute('stroke-width', '2');
        r.setAttribute('class', 'box');
        r.addEventListener('pointerdown', (e) => { 
          if (e.shiftKey) { e.preventDefault(); openCP(name, null); return; } 
          startD(e, 'move', name); 
        });
        g.appendChild(r);

        let lines = [];
        if (name === 'weather') {
          lines = [
            { k:'c1', l:d.ly1, f:19,  t:'6:01am | ☀ 28°C | Feels: 35°C | Hum: 90% | ☁ 88% | 🌧 9% | ☀️ 12%', n:'Weather' }
          ];
        } else if (name === 'solar') {
          lines = [
            { k:'c1', l:d.ly1, f:d.fs,  t:`${d.label}: 1205 w`,         n:'Watts' },
            { k:'c2', l:d.ly2, f:d.fs2, t:'Load: 1225 w',                n:'Load'  },
            { k:'c7', l:d.ly7, f:d.fs7, t:'08:52 AM',                    n:'LTime', ix:7 },
            { k:'c3', l:d.ly3, f:d.fs3, t:'421V | 2.9A | 30.5°C',        n:'V|A'   },
            { k:'c4', l:d.ly4, f:d.fs4, t:'Pred: 3.5 kW | ☁ 60% 🌧 10%', n:'Pred'  },
            { k:'c8', l:d.ly8, f:d.fs8, t:'Pred2: 1.4 kW | ☀️ 40%',      n:'Pred2', ix:8 },
            { k:'c5',  l:d.ly5,  f:d.fs5,  t:'(~3h 43m left)',          n:'Total Left',  ix:5 },
            { k:'c12', l:(d.ly12 !== undefined ? d.ly12 : 247), f:(d.fs12 || 19), t:'(~2h 33m left: 20%)', n:'20% Cutoff', ix:12 },
            { k:'c6',  l:d.ly6,  f:d.fs6,  t:'08:52 AM',        n:'VTime',     ix:6 },
            { k:'c7',  l:d.ly7,  f:d.fs7,  t:'T: 1.3 kWh',      n:'Today kWh', ix:7 },
            { k:'c8',  l:d.ly8,  f:d.fs8,  t:'81 PKR',          n:'Today PKR', ix:8 },
            { k:'c9',  l:d.ly9,  f:d.fs9,  t:'M: 82 kWh',       n:'Month kWh', ix:9 },
            { k:'c10', l:d.ly10, f:d.fs10, t:'4.9k PKR',        n:'Month PKR', ix:10 },
          ];
        } else if (name === 'battery') {
          lines = [
            { k:'c1',  l:d.ly1,  f:d.fs,   t:d.label,                   n:'Title',     ix:1 },
            { k:'c2',  l:d.ly2,  f:d.fs2,  t:'91%',                     n:'SOC %',     ix:2 },
            { k:'c7',  l:d.ly7,  f:d.fs7,  t:'05:33 AM',                n:'Time',      ix:7 },
            { k:'c3',  l:d.ly3,  f:d.fs3,  t:'Discharging: 7.0A',       n:'Action',    ix:3 },
            { k:'c6',  l:d.ly6,  f:d.fs6,  t:'+1412 w <tspan fill="#4ade80">(+1487w)</tspan>', n:'Watts', ix:6 },
            { k:'c13', l:(d.ly13 !== undefined ? d.ly13 : 208), f:(d.fs13 || 19), t:'▼ 16.7%/hr | 0.28%/min', n:'Rate', ix:13 },
            { k:'c5',  l:d.ly5,  f:d.fs5,  t:'(~3h 43m left)',          n:'Total Left',  ix:5 },
            { k:'c12', l:(d.ly12 !== undefined ? d.ly12 : 247), f:(d.fs12 || 19), t:'(~2h 33m left: 20%)', n:'20% Cutoff', ix:12 },
            { k:'c4',  l:d.ly4,  f:d.fs4,  t:'53.0V',                   n:'Volts',     ix:4 },
            { k:'c8',  l:d.ly8,  f:d.fs8,  t:'Chg: M: 8.6 kwh',         n:'Chg M',     ix:8 },
            { k:'c9',  l:d.ly9,  f:d.fs9,  t:'T: 0w Y: 1.2 kwh',        n:'Chg T/Y',   ix:9 },
            { k:'c10', l:d.ly10, f:d.fs10, t:'Disch: M: 4.8 kwh',       n:'Disch M',   ix:10 },
            { k:'c11', l:d.ly11, f:d.fs11, t:'T: 383w Y: 3.4 kwh',      n:'Disch T/Y', ix:11 },
          ];
        } else if (name.startsWith('temp')) {
          lines = [{ k:'c1', l:d.ly1, f:d.fs, t:'29.6°C / 74%', n:'Reading' }];
        } else if (name === 'fridge') {
          lines = [
            { k:'c1', l:d.ly1, f:d.fs,  t:'Fridge 1',              n:'F1 Lbl', ix:1 },
            { k:'c2', l:d.ly2, f:d.fs2, t:'65 w',                  n:'F1 Val', ix:2 },
            { k:'c7', l:d.ly7, f:d.fs7, t:'08:52 AM',              n:'F1 Time', ix:7 },
            { k:'c3', l:d.ly3, f:d.fs3, t:'T: 0.24 kWh M: 12.6 kWh', n:'F1 Stats', ix:3 },
            { k:'c4', l:d.ly4, f:d.fs4, t:'Fridge 2',              n:'F2 Lbl', ix:4 },
            { k:'c5', l:d.ly5, f:d.fs5, t:'0 w',                   n:'F2 Val', ix:5 },
            { k:'c8', l:d.ly8, f:d.fs8, t:'08:52 AM',              n:'F2 Time', ix:8 },
            { k:'c6', l:d.ly6, f:d.fs6, t:'T: 0.31 kWh M: 10.6 kWh', n:'F2 Stats', ix:6 },
          ];
        } else if (name === 'motor') {
          lines = [
            { k:'c1', l:d.ly1, f:d.fs,  t:'Water',                 n:'Title L1' },
            { k:'c1', l:d.ly1 + d.fs + 2, f:d.fs, t:'Motor',       n:'Title L2' },
            { k:'c2', l:d.ly2, f:d.fs2, t:'450 w',                 n:'Watts' },
            { k:'c5', l:d.ly5, f:d.fs5, t:'08:52 AM',              n:'Time', ix:5 },
            { k:'c3', l:d.ly3, f:d.fs3, t:'T: 0.85 kWh',           n:'Today' },
            { k:'c4', l:d.ly4, f:d.fs4, t:'M: 24.2 kWh',           n:'Month' },
          ];
        } else if (name === 'wm') {
          lines = [
            { k:'c1', l:d.ly1, f:d.fs,  t:'Washing',  n:'Title L1' },
            { k:'c1', l:d.ly1 + d.fs + 2, f:d.fs, t:'Machine', n:'Title L2' },
            { k:'c2', l:d.ly2, f:d.fs2, t:'320 w',              n:'Watts' },
            { k:'c3', l:d.ly3, f:d.fs3, t:'T: 0.4 kWh',     n:'Today' },
            { k:'c4', l:d.ly4, f:d.fs4, t:'M: 12.1 kWh',    n:'Month' },
          ];
        } else if (name === 'water') {
          lines = [
            { k:'c1', l:d.ly1, f:d.fs,  t:'Water', n:'Title L1' },
            { k:'c1', l:d.ly1 + d.fs + 2, f:d.fs, t:'Tank',  n:'Title L2' },
            { k:'c2', l:d.ly2, f:d.fs2, t:'81%',    n:'Percent' },
            { k:'c3', l:d.ly3, f:d.fs3, t:'GOOD',   n:'Status'  },
            { k:'c4', l:d.ly4, f:d.fs4, t:'08:52 AM', n:'Time', ix:4 },
            { k:'c5', l:d.ly5, f:d.fs5, t:'▲ 1.5 L/min', n:'Flow', ix:5 },
            { k:'c6', l:d.ly6, f:d.fs6, t:'Ø 20.1 L/min', n:'Avg Flow', ix:6 },
          ];
        } else {
          lines = [
            { k:'c1', l:d.ly1, f:d.fs,  t:d.label,            n:'Title' },
            { k:'c2', l:d.ly2, f:d.fs2, t:'123 w',            n:'Watts' },
            { k:'c5', l:d.ly5, f:d.fs5, t:'08:52 AM',         n:'Time', ix:5 },
            { k:'c3', l:d.ly3, f:d.fs3, t:'T: 0.7 kWh',  n:'Today' },
            { k:'c4', l:d.ly4, f:d.fs4, t:'M: 71.7 kWh', n:'Month' },
          ];
        }

        lines.forEach((line) => {
          const lineNum = parseInt(line.k.substring(1));
          const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          t.setAttribute('x', cx); t.setAttribute('y', d.y + line.l);
          t.setAttribute('font-size', line.f);
          let fill = d[line.k] || '#fff';
          if (name === 'water' && lineNum === 3) fill = '#4ade80';
          t.setAttribute('fill', fill);
          if (line.t && line.t.includes('<tspan')) {
            t.innerHTML = line.t;
          } else {
            t.textContent = line.t;
          }
          t.addEventListener('pointerdown', (e) => { 
            if (e.shiftKey) { e.preventDefault(); openCP(name, lineNum); return; } 
            startD(e, 'text', name, lineNum); 
          });
          t.addEventListener('wheel', (e) => {
            e.preventDefault();
            const key = lineNum === 1 ? 'fs' : `fs${lineNum}`;
            LAYOUT[name][key] = Math.max(6, Math.min(100, (LAYOUT[name][key] || 12) + (e.deltaY < 0 ? 1 : -1)));
            draw();
            showHud(`${name} ${line.n}: ${LAYOUT[name][key]}px`);
          });
          g.appendChild(t);
        });

        // Corner visual triangle handle
        const hSize = 26;
        const x2 = d.x + d.w;
        const y2 = d.y + d.h;
        const handlePath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        handlePath.setAttribute('d', `M ${x2 - hSize} ${y2} L ${x2} ${y2 - hSize} L ${x2} ${y2} Z`);
        handlePath.setAttribute('fill', d.color);
        handlePath.setAttribute('opacity', '0.85');
        handlePath.setAttribute('style', 'pointer-events: none;');

        // Grip lines
        const line1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line1.setAttribute('x1', x2 - 12); line1.setAttribute('y1', y2 - 4);
        line1.setAttribute('x2', x2 - 4);  line1.setAttribute('y2', y2 - 12);
        line1.setAttribute('stroke', '#000'); line1.setAttribute('stroke-width', '2');
        line1.setAttribute('style', 'pointer-events: none;');

        const line2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line2.setAttribute('x1', x2 - 20); line2.setAttribute('y1', y2 - 4);
        line2.setAttribute('x2', x2 - 4);  line2.setAttribute('y2', y2 - 20);
        line2.setAttribute('stroke', '#000'); line2.setAttribute('stroke-width', '2');
        line2.setAttribute('style', 'pointer-events: none;');

        // Large touch hit target for easy dragging
        const hTouch = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        const touchSize = 48;
        hTouch.setAttribute('x', d.x + d.w - touchSize);
        hTouch.setAttribute('y', d.y + d.h - touchSize);
        hTouch.setAttribute('width', touchSize);
        hTouch.setAttribute('height', touchSize);
        hTouch.setAttribute('fill', 'transparent');
        hTouch.setAttribute('class', 'handle');
        hTouch.setAttribute('style', 'cursor: se-resize; touch-action: none;');
        hTouch.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          e.stopPropagation();
          startD(e, 'resize', name);
        });

        g.appendChild(handlePath);
        g.appendChild(line1);
        g.appendChild(line2);
        g.appendChild(hTouch);
        svg.appendChild(g);
      }
      updateOut();
    }

    function openCP(n, l) {
      activeColorNode = n; activeColorLine = l;
      let c = l ? LAYOUT[n][`c${l}`] : LAYOUT[n].color;
      if (c && c.length === 4) c = '#' + c[1]+c[1]+c[2]+c[2]+c[3]+c[3];
      colorPicker.value = c || '#ffffff';
      setTimeout(() => colorPicker.click(), 10);
    }

    colorPicker.addEventListener('input', (e) => {
      if (activeColorLine) LAYOUT[activeColorNode][`c${activeColorLine}`] = e.target.value;
      else LAYOUT[activeColorNode].color = e.target.value;
      draw();
    });

    function startD(e, t, n, l) {
      try { svg.setPointerCapture(e.pointerId); } catch(err) {}
      activeDrag = {
        t, n, l,
        sx: e.clientX, sy: e.clientY,
        ix: LAYOUT[n].x, iy: LAYOUT[n].y,
        iw: LAYOUT[n].w, ih: LAYOUT[n].h,
        il: l ? LAYOUT[n][`ly${l}`] : null
      };
    }

    svg.addEventListener('pointermove', (e) => {
      if (!activeDrag) return;
      const vb = svg.getAttribute('viewBox').split(' ');
      const s = parseFloat(vb[2]) / svg.clientWidth;
      const dx = (e.clientX - activeDrag.sx) * s;
      const dy = (e.clientY - activeDrag.sy) * s;
      const d = LAYOUT[activeDrag.n];
      if (activeDrag.t === 'move') {
        d.x = Math.round(activeDrag.ix + dx);
        d.y = Math.round(activeDrag.iy + dy);
        showHud(`${activeDrag.n} pos: ${d.x}, ${d.y}`);
      } else if (activeDrag.t === 'resize') {
        d.w = Math.max(50, Math.round(activeDrag.iw + dx));
        d.h = Math.max(30, Math.round(activeDrag.ih + dy));
        showHud(`${activeDrag.n} size: ${d.w} × ${d.h}`);
      } else if (activeDrag.t === 'text') {
        d[`ly${activeDrag.l}`] = Math.round(activeDrag.il + dy);
        showHud(`${activeDrag.n} ly${activeDrag.l}: ${d[`ly${activeDrag.l}`]}`);
      }
      draw();
    });

    svg.addEventListener('pointerup', (e) => {
      if (activeDrag) { 
        try { svg.releasePointerCapture(e.pointerId); } catch(err) {} 
        activeDrag = null; 
      }
    });

    svg.addEventListener('pointercancel', (e) => {
      if (activeDrag) { 
        try { svg.releasePointerCapture(e.pointerId); } catch(err) {} 
        activeDrag = null; 
      }
    });

    function showHud(t) {
      hud.textContent = t; hud.style.opacity = 1;
      clearTimeout(hudTimeout);
      hudTimeout = setTimeout(() => hud.style.opacity = 0, 1500);
    }

    function updateOut() {
      let code = 'const LAYOUT = {\n';
      for (const [name, d] of Object.entries(LAYOUT)) {
        let lStr = '';
        for (let i = 1; i <= 13; i++) {
          if (d[`ly${i}`] !== undefined) lStr += `ly${i}:${d[`ly${i}`]}, `;
          const fk = i === 1 ? 'fs' : `fs${i}`;
          if (d[fk] !== undefined) lStr += `${fk}:${d[fk]}, `;
          if (d[`c${i}`] !== undefined) lStr += `c${i}:'${d[`c${i}`]}', `;
        }
        code += ` ${name}: { x:${d.x}, y:${d.y}, w:${d.w}, h:${d.h}, color:'${d.color}', label:'${d.label}', ${lStr} },\n`;
      }
      document.getElementById('output').value = code + '};';
    }

    document.getElementById('btn-copy').addEventListener('click', () => {
      const outputVal = document.getElementById('output').value;
      const updateButtonText = () => {
        const btn = document.getElementById('btn-copy');
        btn.textContent = '✅ Copied!';
        setTimeout(() => btn.textContent = 'Copy Updated LAYOUT Code', 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(outputVal).then(updateButtonText);
      }
    });

    const savedH = localStorage.getItem('editor_preset_height');
    const calculatedInitialHeight = Object.values(LAYOUT).reduce((max, d) => Math.max(max, d.y + d.h), 0) + 15;
    const initialH = savedH ? parseInt(savedH) : Math.max(730, calculatedInitialHeight);
    setCanvasSize(initialH);

    draw();
  
    // ── Copy JS line for js/02-flow.js ────────────────────────────
    document.getElementById('btn-copy-js-line').addEventListener('click', () => {
      const line = `const FLOW_CANVAS_HEIGHT = ${currentHeight};`;
      const done = () => {
        const b = document.getElementById('btn-copy-js-line');
        const orig = b.textContent;
        b.textContent = '✅ Copied!';
        setTimeout(() => b.textContent = orig, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(line).then(done).catch(() => {
          prompt('Copy this line into js/02-flow.js:', line);
        });
      } else {
        prompt('Copy this line into js/02-flow.js:', line);
      }
    });
</script>
</body>
</html>